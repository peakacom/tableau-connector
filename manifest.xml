<?xml version='1.0' encoding='utf-8'?>
<connector-plugin class="peaka_jdbc" superclass="jdbc" plugin-version="1.0.2" name="Peaka Studio" version="18.1" min-version-tableau="2020.4">
	<vendor-information>
		<company name="Peaka" />
		<support-link url="https://www.peaka.com/docs/getting-started/what-is-peaka/" />
		<driver-download-link url="https://central.sonatype.com/artifact/com.peaka/peaka-jdbc" />
	</vendor-information>
	<connection-customization class="peaka_jdbc" enabled="true" version="10.0">
		<vendor name="Peaka" />
		<driver name="Peaka JDBC" />
		<customizations>
			<customization name="CAP_AUTH_DB_IMPERSONATE" value="yes" />
			<customization name="CAP_AUTH_KERBEROS_IMPERSONATE" value="yes" />
			<customization name="CAP_CREATE_TEMP_TABLES" value="no" />
			<customization name="CAP_FORCE_CONNECTION_VERIFICATION" value="yes" />
			<customization name="CAP_JDBC_BIND_DETECT_ALIAS_CASE_FOLDING" value="yes" />
			<customization name="CAP_JDBC_METADATA_READ_FOREIGNKEYS" value="no" />
			<customization name="CAP_JDBC_METADATA_READ_PRIMARYKEYS" value="no" />
			<customization name="CAP_JDBC_METADATA_SUPPRESS_PREPARED_QUERY" value="yes" />
			<customization name="CAP_JDBC_QUERY_ASYNC" value="yes" />
			<customization name="CAP_QUERY_AGG_NO_BOOLEXPR" value="no" />
			<customization name="CAP_QUERY_BOOLEXPR_TO_INTEXPR" value="no" />
			<customization name="CAP_QUERY_BOOL_IDENTIFIER_TO_LOGICAL" value="yes" />
			<customization name="CAP_QUERY_CASE_OUT_NO_BOOL_OPS" value="no" />
			<customization name="CAP_QUERY_GROUP_BY_BOOL" value="yes" />
			<customization name="CAP_QUERY_INITIAL_SQL_SPLIT_STATEMENTS" value="yes" />
			<customization name="CAP_QUERY_SUBQUERIES" value="yes" />
			<customization name="CAP_QUERY_TOP_0_METADATA" value="yes" />
			<customization name="CAP_QUERY_TOP_N" value="yes" />
			<customization name="CAP_SELECT_INTO" value="no" />
			<customization name="CAP_SELECT_TOP_INTO" value="no" />
			<customization name="CAP_SUPPORTS_SPLIT_FROM_LEFT" value="yes" />
			<customization name="CAP_SUPPORTS_SPLIT_FROM_RIGHT" value="yes" />
		</customizations>
	</connection-customization>
	<connection-fields file="connection-fields.xml" />
	<connection-metadata file="connection-metadata.xml" />
	
	<connection-resolver file="connectionResolver.tdr" />
	<dialect file="dialect.tdd" />
    
</connector-plugin>